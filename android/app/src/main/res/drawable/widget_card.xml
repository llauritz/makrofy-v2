<?xml version="1.0" encoding="utf-8"?>
<!-- The widget's card: SummaryCard's surface, 28dp corners and a solid
     hairline outline. Colours resolve per theme when the launcher draws it. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/widget_card" />
    <stroke android:width="1dp" android:color="@color/widget_border" />
    <corners android:radius="28dp" />
</shape>
